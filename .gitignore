# Playwright
playwright-report/
test-results/

# playwright-bdd generates these from e2e/features/*.feature directly into
# e2e/ (its output dir must match Playwright's testDir exactly, so it cannot
# live in its own gitignored subfolder — see the comment in
# playwright.config.ts and docs/adr/0008-gherkin-feature-files-for-e2e.md).
e2e/**/*.feature.spec.js

# Claude Code local state
.claude/settings.local.json

# This dev server launch config holds nothing machine-specific: it names only
# `npm run dev` and lets the harness assign the port. Claude Code suggests
# ignoring the path globally; a rule here outranks that.
!.claude/launch.json

# Transient planning documents: specs, plans, briefs and ledgers.
# See docs/adr/0007-transient-plans-durable-decisions.md
docs/superpowers/

# Worktrees created by the desktop app.
.claude/worktrees/
